
generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}


datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  user
}

model User {
  id              Int            @id @default(autoincrement())
  nombre          String
  email           String         @unique
  passwordHash    String
  role            UserRole       @default(user)
  interacciones   Interaction[]
  cartItems       CartItem[]
  wishlistItems   WishlistItem[]

  @@map("users")
}

model Product {
  id             Int           @id @default(autoincrement())
  nombre         String
  descripcion    String
  precio         Float
  imagen         String?
  categoria      String
  stock          Int           @default(0)
  interacciones  Interaction[]
  cartItems      CartItem[]
  wishlistItems  WishlistItem[]

  @@map("products")
}

model Interaction {
  id          Int      @id @default(autoincrement())
  userId      Int
  productId   Int?
  nombreMichi String
  mensaje     String
  createdAt   DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([productId])
  @@map("interactions")
}

model CartItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  cantidad  Int      @default(1)
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@map("cart_items")
}

model WishlistItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@map("wishlist_items")
}

